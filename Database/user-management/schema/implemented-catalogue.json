    },
    {
      "schema_name": "public",
      "table_name": "profile_operation",
      "conname": "profile_operation_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (operation_id)"
    },
    {
      "schema_name": "public",
      "table_name": "profile_operation",
      "conname": "um_accountable_actor",
      "contype": "c",
      "definition": "CHECK (((actor_user_id IS NOT NULL) OR ((actor_service IS NOT NULL) AND (length(TRIM(BOTH FROM actor_service)) > 0))))"
    },
    {
      "schema_name": "public",
      "table_name": "profile_operation",
      "conname": "um_confirmation_pair",
      "contype": "c",
      "definition": "CHECK (((confirmation_id IS NULL) = (confirmed_at IS NULL)))"
    },
    {
      "schema_name": "public",
      "table_name": "profile_operation",
      "conname": "um_expected_revision",
      "contype": "c",
      "definition": "CHECK (((expected_revision IS NULL) OR (expected_revision > 0)))"
    },
    {
      "schema_name": "public",
      "table_name": "profile_operation",
      "conname": "um_mcp_write_confirmation",
      "contype": "c",
      "definition": "CHECK (((channel <> 'MCP'::um_channel) OR (outcome <> 'Applied'::um_operation_outcome) OR (confirmation_id IS NOT NULL)))"
    },
    {
      "schema_name": "public",
      "table_name": "profile_operation",
      "conname": "um_operation_basis",
      "contype": "c",
      "definition": "CHECK (((length((request_fingerprint)::text) = 64) AND (length(TRIM(BOTH FROM authority_basis)) > 0) AND (length(TRIM(BOTH FROM command_name)) > 0) AND (length(TRIM(BOTH FROM target_kind)) > 0) AND (length(TRIM(BOTH FROM outcome_code)) > 0)))"
    },
    {
      "schema_name": "public",
      "table_name": "profile_operation",
      "conname": "um_result_revision",
      "contype": "c",
      "definition": "CHECK (((resulting_revision IS NULL) OR (resulting_revision > 0)))"
    },
