Project Vairas_User_Management {
  database_type: 'PostgreSQL'
  Note: 'MVP refinement requested by owner, 2026-11-15 (D-043). Four existing profile roots and one local operation table. Global profiles have no SchoolId. Account control and immutable profile binding are not proof of physical identity. Existing StudentId is reused across schools; physical-person deduplication is not guaranteed. No verification/merge workflow, new person key, credentials, memberships or cross-service FK. New API/security choices are design recommendations, not deployed features.'
}
Enum um_user_status {
  Active
  Inactive
}
Enum um_operation_outcome {
  Applied
  Rejected
}
Enum um_channel {
  Web
  MCP
  Internal
}

Table user_profile {
  user_id uuid [pk, not null]
  identity_id uuid [not null, unique, note: 'External Authentication identity. Server resolves from validated subject; never accepted from profile request body. One per UserProfile in MVP.']
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email_address varchar(254) [note: 'Optional nonunique contact. Not login, verified-contact authority or physical identity proof.']
  phone_number varchar(32) [note: 'Optional contact; not identity proof.']
  status um_user_status [not null, default: 'Active']
  revision bigint [not null, default: 1]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  checks {
    `length(trim(first_name)) > 0 AND length(trim(last_name)) > 0` [name: 'um_nonblank_name']
    `email_address IS NULL OR length(trim(email_address)) > 0` [name: 'um_nonblank_email']
    `phone_number IS NULL OR length(trim(phone_number)) > 0` [name: 'um_nonblank_phone']
    `revision > 0 AND updated_at >= created_at` [name: 'um_profile_revision_time']
  }
  Note: 'UserProfile root. Active/Inactive is global account-linked operational status, not physical identity verification or a school membership. Ordinary edits cannot change IDs/binding/status. D-045 global deactivation requires an active deployment-allowlisted platform operator; school exclusion remains School Management. History retained. No public hard delete or account rebind in MVP.'
}

Table student_profile {
  student_id uuid [pk, not null, note: 'Existing stable User Management ID, D-032; never regenerated for a new school.']
  user_id uuid [not null, unique]
  created_at timestamptz [not null]
  Note: 'StudentProfile root; immutable ID/UserId binding, one per user. No identity-verification state, redirect or merge. Multiple accounts for the same physical person may still create duplicates; uniqueness proves only one StudentProfile per UserProfile. No mutable student fields, so no redundant revision token.'
}

Table teacher_profile {
  teacher_id uuid [pk, not null]
  user_id uuid [not null, unique]
  created_at timestamptz [not null]
  Note: 'TeacherProfile root. Created by target self with a current school-authorized Teacher onboarding invitation. Immutable binding; not qualification, school membership, assignment or Assessor permission. Global status comes from UserProfile.'
}

Table administrator_profile {
  administrator_id uuid [pk, not null]
  user_id uuid [not null, unique]
  created_at timestamptz [not null]
  Note: 'AdministratorProfile root. Target accepts explicitly authorized school-admin onboarding; first administrator uses a trusted platform bootstrap operation. Immutable binding; existence grants no school or global platform permission.'
}

Table profile_operation {
  operation_id uuid [pk, not null]
  actor_user_id uuid [note: 'Logical actor reference, no FK. System/bootstrap actor instead identifies accountable service.']
  actor_service varchar(120)
  requesting_school_id uuid [note: 'Optional external authority context, not global profile ownership. Required for invitation-scoped role provisioning.']
  authority_basis varchar(250) [not null, note: 'Restricted subject/permission/invitation reference; not bearer token or raw invitation.']
  channel um_channel [not null]
  command_name varchar(80) [not null]
  target_kind varchar(80) [not null]
  target_id uuid [not null]
  expected_revision bigint
  resulting_revision bigint
  request_fingerprint varchar(64) [not null]
  outcome um_operation_outcome [not null]
  outcome_code varchar(80) [not null]
  recorded_at timestamptz [not null]
  reason text
  confirmation_id uuid
  confirmed_at timestamptz
  indexes {
    (target_kind, target_id, recorded_at)
  }
  checks {
    `actor_user_id IS NOT NULL OR (actor_service IS NOT NULL AND length(trim(actor_service)) > 0)` [name: 'um_accountable_actor']
    `expected_revision IS NULL OR expected_revision > 0` [name: 'um_expected_revision']
    `resulting_revision IS NULL OR resulting_revision > 0` [name: 'um_result_revision']
    `length(request_fingerprint) = 64 AND length(trim(authority_basis)) > 0 AND length(trim(command_name)) > 0 AND length(trim(target_kind)) > 0 AND length(trim(outcome_code)) > 0` [name: 'um_operation_basis']
    `(confirmation_id IS NULL) = (confirmed_at IS NULL)` [name: 'um_confirmation_pair']
    `channel <> 'MCP' OR outcome <> 'Applied' OR confirmation_id IS NOT NULL` [name: 'um_mcp_write_confirmation']
  }
  Note: 'Local append-only outcome/idempotency record, not domain root or distributed workflow. Mutation and Applied outcome commit together; rejected authenticated command may record Rejected without mutation. Concurrent unique operation-ID claims serialize. Compare actor/service/school/channel/command/target/exact canonical payload on retry and reauthorize replay. No Pending, Coordinating or ReconciliationPending here. No remote write is performed inside this transaction. Generic target is handler-checked; unknown-ID denials need no target FK. School-visible audit is a restricted projection, not this global table. Immutable-role creation has NULL expected/result revisions.'
}

Table outbox_message {
  event_id uuid [pk, not null]
  aggregate_id uuid [not null, note: 'Logical UserId of the event subject; no local FK is declared in the canonical DDL.']
  aggregate_version bigint [not null]
  event_type varchar(80) [not null]
  body jsonb [not null, note: 'Immutable outgoing envelope/payload; may repeat routing metadata intentionally.']
  correlation_id varchar(128) [not null]
  trace_parent varchar(128)
  occurred_at timestamptz [not null]
  next_attempt_at timestamptz [not null]
  published_at timestamptz
  lease_id uuid
  leased_until timestamptz
  attempts int [not null]
  last_error_code varchar(80)
  checks {
    `aggregate_version > 0 AND attempts >= 0` [name: 'outbox_version']
    `(lease_id IS NULL) = (leased_until IS NULL)` [name: 'outbox_lease']
  }
  Note: 'Technical delivery metadata, not a sixth domain aggregate. The canonical DDL declares a partial index on (next_attempt_at, occurred_at) WHERE published_at IS NULL. Runtime may insert events and update only delivery/lease fields; no automatic cleanup is implemented.'
}

Ref: student_profile.user_id > user_profile.user_id [delete: restrict]
Ref: teacher_profile.user_id > user_profile.user_id [delete: restrict]
Ref: administrator_profile.user_id > user_profile.user_id [delete: restrict]
