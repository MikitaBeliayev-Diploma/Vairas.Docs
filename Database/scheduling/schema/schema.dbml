Project Vairas_Scheduling_RuleBased {
  database_type: 'PostgreSQL'
  Note: 'D-044 business baseline plus G-01 actual interval and explicit 2026-11-24 reliability implementation. 23 tables; no cross-service database FKs. UTC instants; Europe/Vilnius calendar. See implementation.md for storage and authority boundaries.'
}

Enum request_status {
  Draft
  Submitted
  Ready
  Infeasible
  Rejected
  Stale
  Superseded
  Confirmed
}

Enum lesson_kind {
  Practical
  Theory
}

Enum lesson_status {
  Scheduled
  Completed
  Cancelled
  NoShow
}

Enum operation_status {
  Pending
  Committed
  Rejected
  ReconciliationPending
}

Enum reservation_status {
  Active
  Released
}

Enum recurrence_frequency {
  Daily
  Weekly
}









Table scheduling_request {
  inputs_json text [not null]
  basis_json text [not null]
  school_revision bigint [not null]

  id uuid [not null]
  revision int [not null]
  school_id uuid [not null]
  status request_status [not null, default: 'Draft']
  planning_start date
  planning_end date
  submitted_by_user_id uuid
  submitted_at timestamptz
  generated_at timestamptz
  confirmed_operation_id uuid
  confirmed_at timestamptz
  created_by_user_id uuid [not null]
  created_at timestamptz [not null]
  indexes {
    (id, revision) [pk]
    (id, revision, school_id) [unique]
    (school_id, status)
  }
  Note: 'Request revision identifies an exact frozen input/candidate basis, not the concurrency revision of a lesson. Submitted/Ready/Confirmed states require validated complete input when entered. Confirm exact request id/revision and revalidate current sources. Confirmed input/candidates are never regenerated in place. Rejected validation does not imply a valid submitted snapshot. Metadata CHECKs are generated by EF Core. Dates are interpreted in configured Europe/Vilnius. Revision immutability, same-school ownership and lifecycle transitions are guarded by application services and authorization.'
  checks {
    `revision > 0` [name: 'request_revision_positive']
    `planning_start IS NULL OR planning_end IS NULL OR planning_end >= planning_start` [name: 'request_period']
    `(submitted_at IS NULL) = (submitted_by_user_id IS NULL)` [name: 'request_submitted_pair']
    `(status = 'Confirmed' AND confirmed_at IS NOT NULL AND confirmed_operation_id IS NOT NULL) OR (status <> 'Confirmed' AND confirmed_at IS NULL AND confirmed_operation_id IS NULL)` [name: 'request_confirmed_metadata']
    `status NOT IN ('Submitted','Ready','Infeasible','Stale','Superseded','Confirmed') OR (submitted_at IS NOT NULL AND planning_start IS NOT NULL AND planning_end IS NOT NULL)` [name: 'request_validated_metadata']
    `status NOT IN ('Ready','Confirmed') OR generated_at IS NOT NULL` [name: 'request_ready_metadata']
  }
}


Table scheduling_request_enrollment {
  request_id uuid [not null]
  request_revision int [not null]
  enrollment_id uuid [not null, note: 'External School Management ID']
  student_id uuid [note: 'Existing User Management ID; resolve and validate before submission']
  enrollment_revision bigint
  training_program_version_id uuid [note: 'External Learning Tracking ID']
  category_code varchar(16)
  indexes {
    (request_id, request_revision, enrollment_id) [pk]
  }
  Note: 'Freeze exact enrollment/programme basis. Owner contract D-032: the same physical learner has the same existing StudentId across schools. User Management must preserve uniqueness and resolve duplicates; unresolved identity blocks matching; do not infer identity from EnrollmentId/name/email.'
  checks {
    `request_revision > 0` [name: 'scheduling_request_enrollment_revision']
  }
}

Table scheduling_request_group {
  request_id uuid [not null]
  request_revision int [not null]
  training_program_version_id uuid [note: 'External Learning Tracking immutable programme/requirement version; required on submission, nullable in Draft']
  category_code varchar(16) [note: 'Frozen group category; required on submission, nullable in Draft']
  group_id uuid [not null, note: 'External School Management ID']
  membership_revision bigint [note: 'Must be current at submission and confirmation; immutable source membership must be retrievable']
  indexes {
    (request_id, request_revision, group_id) [pk]
  }
  checks {
    `request_revision > 0` [name: 'scheduling_request_group_revision']
  }
}

Table scheduling_request_resource {
  request_id uuid [not null]
  request_revision int [not null]
  resource_kind varchar(24) [not null, note: 'Instructor / Vehicle / Branch']
  resource_id uuid [not null, note: 'Logical ID from owning bounded context']
  eligibility_revision bigint [note: 'Required when validated and submitted']
  indexes {
    (request_id, request_revision, resource_kind, resource_id) [pk]
  }
  checks {
    `request_revision > 0` [name: 'scheduling_request_resource_revision']
    `resource_kind IN ('Instructor','Vehicle','Branch')` [name: 'resource_kind_valid']
    `eligibility_revision IS NULL OR eligibility_revision > 0` [name: 'resource_source_revision']
  }

}

Table scheduling_request_window {
  id uuid [pk]
  request_id uuid [not null]
  request_revision int [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  Note: 'All request windows are hard planning input. School preferences live in versioned rules. Require ends_at > starts_at.'
  checks {
    `ends_at > starts_at` [name: 'window_interval']
  }
}




Table scheduling_rule_version {
  id uuid [pk]
  rule_id uuid [not null, note: 'Stable identity across rule versions']
  revision int [not null]
  source_kind varchar(16) [not null, note: 'Legal / School']
  school_id uuid [note: 'School-specific rules require school_id; Legal rules have null here']
  category_code varchar(16)
  rule_code varchar(80) [not null]
  severity varchar(16) [not null, note: 'Hard / Preference; Legal must be Hard']
  override_policy varchar(24) [not null, note: 'Locked for Legal, SchoolEditable for School. Application checks no weakening of effective Legal rules']
  scope_kind varchar(24) [not null, note: 'School / Instructor / Vehicle / Branch / Group / Student']
  scope_resource_id uuid [note: 'NULL only for School scope; external logical ID otherwise']
  decision_reason varchar(500) [note: 'Explanation for verification or rejection; immutable with version']
  numeric_limit decimal(12,3)
  unit varchar(32)
  effective_from timestamptz [not null]
  effective_to timestamptz
  source_reference varchar(400) [not null]
  verification_status varchar(24) [not null, note: 'Verified / Pending / Rejected']
  decided_at timestamptz
  created_by_user_id uuid [not null]
  created_at timestamptz [not null]
  decided_by_user_id uuid
  indexes {
    (rule_id, revision) [unique]
    (source_kind, school_id, rule_code)
  }
  Note: 'Frozen referenced versions must retain their source/semantics. Rule_code and typed numeric/unit values support only an explicitly implemented catalogue; non-numeric applicability/parameters may need a later design. Do not assume every scheduling restriction can be encoded here.'
  checks {
    `revision > 0` [name: 'rule_revision']
    `source_kind IN ('Legal','School')` [name: 'rule_source_kind']
    `(source_kind = 'Legal' AND school_id IS NULL) OR (source_kind = 'School' AND school_id IS NOT NULL)` [name: 'rule_school_scope']
    `severity IN ('Hard','Preference') AND (source_kind <> 'Legal' OR severity = 'Hard')` [name: 'rule_severity']
    `verification_status IN ('Verified','Pending','Rejected')` [name: 'rule_verification']
    `(verification_status = 'Pending' AND decided_at IS NULL AND decided_by_user_id IS NULL) OR (verification_status IN ('Verified','Rejected') AND decided_at IS NOT NULL AND decided_by_user_id IS NOT NULL)` [name: 'rule_decision_actor']
    `effective_to IS NULL OR effective_to > effective_from` [name: 'rule_effective_interval']
    `override_policy IN ('Locked','SchoolEditable') AND ((source_kind = 'Legal' AND override_policy = 'Locked') OR (source_kind = 'School' AND override_policy = 'SchoolEditable'))` [name: 'rule_override_policy']
    `scope_kind IN ('School','Instructor','Vehicle','Branch','Group','Student') AND ((scope_kind = 'School' AND scope_resource_id IS NULL) OR (scope_kind <> 'School' AND scope_resource_id IS NOT NULL))` [name: 'rule_scope']
    `(numeric_limit IS NULL AND unit IS NULL) OR (numeric_limit > 0 AND unit IS NOT NULL)` [name: 'rule_typed_limit']
  }
}

Table scheduling_request_rule {
  request_id uuid [not null]
  request_revision int [not null]
  rule_version_id uuid [not null, ref: > scheduling_rule_version.id]
  indexes {
    (request_id, request_revision, rule_version_id) [pk]
  }
  checks {
    `request_revision > 0` [name: 'scheduling_request_rule_revision']
  }
}



Table scheduling_operation_rule {
  operation_id uuid [not null]
  rule_version_id uuid [not null]
  indexes {
    (operation_id, rule_version_id) [pk]
  }
  Note: 'Application service writes the exact checked versions during the same atomic transaction as the operation, lessons and reservation claims. Immutable after commit.'
}

Table candidate_lesson {
  id uuid [pk]
  request_id uuid [not null]
  request_revision int [not null]
  kind lesson_kind [not null]
  student_id uuid
  enrollment_id uuid [note: 'Required for Practical, null for Theory']
  group_id uuid [note: 'Required for Theory, null for Practical']
  teacher_id uuid [not null]
  vehicle_id uuid [note: 'Required for Practical, null for Theory']
  branch_id uuid [not null]
  series_id uuid
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  category_code varchar(16) [not null]
  indexes {
    (request_id, request_revision)
    (id, request_id, request_revision) [unique]
  }
  Note: 'Unconfirmed placements reserve nothing. Rule versions selected through scheduling_request_rule. Freeze Ready candidates. No specialized daily-rule FK.'
  checks {
    `ends_at > starts_at` [name: 'candidate_interval']
    `(kind = 'Practical' AND enrollment_id IS NOT NULL AND student_id IS NOT NULL AND vehicle_id IS NOT NULL AND group_id IS NULL) OR (kind = 'Theory' AND group_id IS NOT NULL AND enrollment_id IS NULL AND student_id IS NULL AND vehicle_id IS NULL)` [name: 'candidate_type']
  }
}

Table candidate_lesson_participant {
  candidate_lesson_id uuid [not null, ref: > candidate_lesson.id]
  enrollment_id uuid [not null]
  student_id uuid [not null, note: 'Existing User Management student ID']
  membership_revision bigint [not null]
  indexes {
    (candidate_lesson_id, enrollment_id) [pk]
    (candidate_lesson_id, student_id) [unique]
  }
  Note: 'Theory candidates only; match the authorized effective group membership and its retrievable version. Validate canonical student identity before any global availability check.'
  checks {
    `membership_revision > 0` [name: 'candidate_lesson_participant_membership_revision']
  }
}


Table recurring_lesson_series {
  id uuid [pk]
  school_id uuid [not null]
  kind lesson_kind [not null]
  frequency recurrence_frequency [not null]
  recurrence_interval int [not null, default: 1]
  weekdays "smallint[]" [note: 'ISO days 1..7, Monday..Sunday; nonempty unique set for Weekly, empty for Daily']
  local_start_time time [not null]
  duration_minutes int [not null]
  time_zone varchar(80) [not null]
  starts_on date [not null]
  ends_on date
  occurrence_count int
  indexes {
    (id, school_id, kind) [unique]
  }
  Note: 'Concrete lessons remain independent. Require positive interval/duration/count and either ends_on or occurrence_count as end condition, valid weekdays and end >= start. Daily/Weekly, the typed weekday array and time/end fields are explicit candidate choices from the prior discussion, not extra BA requirements; DST/local-time handling remains to define.'
  checks {
    `recurrence_interval > 0 AND duration_minutes > 0` [name: 'recurrence_positive']
    `(ends_on IS NOT NULL)::int + (occurrence_count IS NOT NULL)::int = 1` [name: 'recurrence_end_choice']
    `ends_on IS NULL OR ends_on >= starts_on` [name: 'recurrence_end_range']
    `occurrence_count IS NULL OR occurrence_count > 0` [name: 'recurrence_count']
    `(frequency = 'Daily' AND coalesce(cardinality(weekdays),0) = 0) OR (frequency = 'Weekly' AND weekdays IS NOT NULL AND cardinality(weekdays) BETWEEN 1 AND 7 AND weekdays <@ ARRAY[1,2,3,4,5,6,7]::smallint[])` [name: 'recurrence_weekdays']
  }
}

Table lesson {
  id uuid [pk]
  school_id uuid [not null]
  kind lesson_kind [not null]
  branch_id uuid [not null]
  teacher_id uuid [not null]
  enrollment_id uuid [note: 'Required for Practical, null for Theory']
  student_id uuid [note: 'Existing User Management ID for Practical; canonical identity contract required for cross-school matching']
  vehicle_id uuid [note: 'Required for Practical, null for Theory']
  group_id uuid [note: 'Required for Theory, null for Practical']
  group_membership_revision bigint
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  actual_start timestamptz
  actual_end timestamptz
  status lesson_status [not null, default: 'Scheduled']
  revision int [not null, default: 1, note: 'Retained by owner: optimistic concurrency token; update only if expected revision matches']
  series_id uuid
  source_candidate_id uuid [unique, note: 'At most one committed lesson from a candidate. Manual lessons may have no candidate source']
  created_at timestamptz [not null]
  category_code varchar(16) [not null]
  indexes {
    (id, school_id) [unique]
    (school_id, starts_at)
    (teacher_id, starts_at, ends_at)
  }
  Note: 'Practical: one enrollment/student/vehicle, no group. Theory: one group, no practical enrollment/student/vehicle; participants below. CHECKs enforce intervals, source pairs and kind-specific shapes. For generated lesson, source_candidate_id references retained candidate -> request/revision. Same-school and assignment consistency are checked in authorized backend. Scheduling owns the physical actual interval and lifecycle revision. Completed is not credited training; training minutes, attendance and confirmations belong to Learning Tracking.'
  checks {
    `revision > 0` [name: 'lesson_revision_positive']
    `(kind = 'Practical' AND group_membership_revision IS NULL) OR (kind = 'Theory' AND group_membership_revision IS NOT NULL AND group_membership_revision > 0)` [name: 'lesson_membership_basis']
    `ends_at > starts_at` [name: 'lesson_interval']
    `(actual_start IS NULL AND actual_end IS NULL) OR (actual_start IS NOT NULL AND actual_end IS NOT NULL AND actual_end > actual_start)` [name: 'lesson_actual_interval']
    `status <> 'Completed' OR (actual_start IS NOT NULL AND actual_end IS NOT NULL)` [name: 'lesson_completed_requires_actuals']
    `(kind = 'Practical' AND enrollment_id IS NOT NULL AND student_id IS NOT NULL AND vehicle_id IS NOT NULL AND group_id IS NULL) OR (kind = 'Theory' AND group_id IS NOT NULL AND enrollment_id IS NULL AND student_id IS NULL AND vehicle_id IS NULL)` [name: 'lesson_type']
  }

}

Table lesson_participant {
  is_active boolean [not null]

  lesson_id uuid [not null, ref: > lesson.id]
  enrollment_id uuid [not null]
  student_id uuid [not null, note: 'Existing User Management ID']
  membership_revision bigint [not null]
  indexes {
    (lesson_id, enrollment_id) [pk]
    (lesson_id, student_id) [unique]
  }
  Note: 'Theory lessons only. Preserve the effective participant basis; membership changes must coordinate reservations. This table is not by itself actual attendance or confirmed theory credit.'
  checks {
    `membership_revision > 0` [name: 'lesson_participant_membership_revision']
  }
}

Table scheduling_operation {
  fingerprint varchar(64) [not null]
  result_json text [not null]
  http_status integer [not null]

  id uuid [pk]
  school_id uuid [not null]
  action_type varchar(32) [not null, note: 'ConfirmSchedule / CreateLesson / Reschedule / Cancel / ChangeGroup']
  request_id uuid
  request_revision int
  actor_user_id uuid [not null]
  channel varchar(16) [not null, note: 'Web / MCP']
  reason varchar(500)
  status operation_status [not null, default: 'Pending']
  started_at timestamptz [not null]
  finished_at timestamptz
  target_lesson_id uuid
  expected_lesson_revision int
  target_appointment_id uuid
  result_lesson_id uuid
  result_appointment_id uuid
  outcome_code varchar(64)
  user_confirmed_at timestamptz
  indexes {
    (id, school_id) [unique]
  }
  Note: 'No fingerprint or idempotency key columns. Operation id is the only persisted operation identity (PK); retries with a new operation id are NOT deduplicated by DB. The application must define trusted retry/unknown-outcome recovery and exact MCP consent; do not claim exactly-once write behavior. Revalidate rules/resources and avoid partial writes.'
  checks {
    `action_type IN ('ConfirmSchedule','CreateLesson','Reschedule','Cancel','ChangeGroup','CompleteLesson','CorrectActualInterval','CreateAssessment','CancelAssessment','CreateDraft','ReviseDraft','SubmitRequest','GenerateProposal','PublishRule')` [name: 'operation_action']
    `channel IN ('Web','MCP','Internal')` [name: 'operation_channel']
    `(request_id IS NULL) = (request_revision IS NULL)` [name: 'operation_request_pair']
    `(status = 'Pending' AND finished_at IS NULL) OR (status = 'ReconciliationPending') OR (status IN ('Committed','Rejected') AND finished_at IS NOT NULL)` [name: 'operation_finished']
    `expected_lesson_revision IS NULL OR expected_lesson_revision > 0` [name: 'operation_expected_revision']
    `target_lesson_id IS NULL OR target_appointment_id IS NULL` [name: 'operation_target_xor']
  }
}

Table reservation_claim {
  id uuid [pk]
  operation_id uuid [not null]
  lesson_id uuid
  assessment_appointment_id uuid
  school_id uuid [not null]
  resource_kind varchar(24) [not null, note: 'Student / Instructor / Vehicle / Group']
  resource_key uuid [not null, note: 'Existing student_id, teacher_id, vehicle_id or group_id according to kind; never EnrollmentId or a new global-person surrogate']
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  status reservation_status [not null, default: 'Active']
  created_at timestamptz [not null]
  released_at timestamptz
  indexes {
    (resource_kind, resource_key, starts_at, ends_at)
    (lesson_id, resource_kind, resource_key)
  }
  Note: 'A small EF Core migration installs PostgreSQL EXCLUDE for Active claims on the same resource across schools; commit all lesson/claim changes atomically, reconcile unknown outcomes. StudentId is the same across schools by owner contract D-032; its identity-proofing implementation remains a production dependency. No communication technology or outbox is selected.'
  checks {
    `ends_at > starts_at` [name: 'claim_interval']
    `(lesson_id IS NOT NULL)::int + (assessment_appointment_id IS NOT NULL)::int = 1` [name: 'claim_owner']
    `resource_kind IN ('Student','Instructor','Vehicle','Group')` [name: 'claim_kind']
    `(status = 'Active' AND released_at IS NULL) OR (status = 'Released' AND released_at IS NOT NULL AND released_at >= created_at)` [name: 'claim_release']
  }
}




Table lesson_change {
  id uuid [pk]
  school_id uuid [not null]
  lesson_id uuid [not null]
  operation_id uuid [not null]
  revision int [not null, note: 'New revision after the change; previous state belongs to revision - 1']
  previous_status lesson_status [not null]
  previous_actual_start timestamptz
  previous_actual_end timestamptz
  previous_start timestamptz [not null]
  previous_end timestamptz [not null]
  previous_teacher_id uuid [not null]
  previous_vehicle_id uuid
  previous_branch_id uuid [not null]
  previous_series_id uuid
  previous_group_membership_revision bigint
  changed_at timestamptz [not null]
  indexes {
    (lesson_id, revision) [unique]
  }
  checks {
    `revision > 1` [name: 'history_revision_positive']
    `previous_end > previous_start` [name: 'history_previous_interval']
    `(previous_actual_start IS NULL AND previous_actual_end IS NULL) OR (previous_actual_start IS NOT NULL AND previous_actual_end IS NOT NULL AND previous_actual_end > previous_actual_start)` [name: 'history_actual_interval']
  }
  Note: 'Append-only OLD-state snapshot on lesson mutation. Rule snapshots are linked to immutable scheduling_operation_rule; previous actual interval belongs to this Scheduling revision; teaching minutes and confirmations belong to Learning Tracking. Do not mutate student/group identity on reschedule.'
}




Table assessment_appointment {
  readiness_evaluation_id uuid [not null]
  revision integer [not null]

  id uuid [pk]
  school_id uuid [not null]
  kind lesson_kind [not null]
  enrollment_id uuid [not null]
  student_id uuid [not null]
  assessment_definition_id uuid [not null]
  outstanding_requirement_id uuid
  reason varchar(500) [not null]
  teacher_id uuid [not null, note: 'Authorized assessor TeacherId; authorization validated by the owning-context contract']
  vehicle_id uuid
  branch_id uuid [not null]
  category_code varchar(16) [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  status lesson_status [not null, default: 'Scheduled']
  created_at timestamptz [not null]
  indexes {
    (id, school_id) [unique]
  }
  checks {
    `ends_at > starts_at` [name: 'assessment_interval']
    `(kind = 'Practical' AND vehicle_id IS NOT NULL) OR (kind = 'Theory' AND vehicle_id IS NULL)` [name: 'assessment_type']
  }
  Note: 'Time/resource appointment only; no assessment result or readiness decision. Allocation/time immutable after creation: cancel and create a new appointment to change them. Operations retain actor/outcome audit for create/cancel. Proposed practical daily-budget accounting includes these reservations conservatively; exact legal inclusion must be verified.'
}


Ref: scheduling_request_enrollment.(request_id, request_revision) > scheduling_request.(id, revision)
Ref: scheduling_request_group.(request_id, request_revision) > scheduling_request.(id, revision)
Ref: scheduling_request_resource.(request_id, request_revision) > scheduling_request.(id, revision)
Ref: scheduling_request_window.(request_id, request_revision) > scheduling_request.(id, revision)
Ref: scheduling_request_rule.(request_id, request_revision) > scheduling_request.(id, revision)
Ref: candidate_lesson.(request_id, request_revision) > scheduling_request.(id, revision)
Ref: lesson.(series_id, school_id, kind) > recurring_lesson_series.(id, school_id, kind)
Ref: scheduling_operation.(request_id, request_revision, school_id) > scheduling_request.(id, revision, school_id)
Ref: scheduling_request.(confirmed_operation_id, school_id) > scheduling_operation.(id, school_id)
Ref: reservation_claim.(operation_id, school_id) > scheduling_operation.(id, school_id)
Ref: reservation_claim.(lesson_id, school_id) > lesson.(id, school_id)
Ref: lesson_change.(lesson_id, school_id) > lesson.(id, school_id)
Ref: lesson_change.(operation_id, school_id) > scheduling_operation.(id, school_id)

Ref: lesson.source_candidate_id > candidate_lesson.id
Ref: candidate_lesson.series_id > recurring_lesson_series.id
Ref: reservation_claim.(assessment_appointment_id, school_id) > assessment_appointment.(id, school_id)
Ref: scheduling_operation.(target_lesson_id, school_id) > lesson.(id, school_id)
Ref: scheduling_operation.(result_lesson_id, school_id) > lesson.(id, school_id)
Ref: scheduling_operation.(target_appointment_id, school_id) > assessment_appointment.(id, school_id)
Ref: scheduling_operation.(result_appointment_id, school_id) > assessment_appointment.(id, school_id)

Ref: scheduling_operation_rule.operation_id > scheduling_operation.id
Ref: scheduling_operation_rule.rule_version_id > scheduling_rule_version.id

// 2026-11-24 implementation reliability tables. IDs are logical references unless explicit Ref exists.

Table gate_command {
  id uuid [pk, not null]
  school_id uuid [not null]
  fingerprint text [not null]
  kind text [not null]
  result_json text [not null]
  http_status integer [not null]
}

Table outbox_message {
  id uuid [pk, not null]
  school_id uuid [not null]
  aggregate_id uuid [not null]
  aggregate_version integer [not null]
  event_type text [not null]
  payload text [not null]
  occurred_at timestamptz [not null]
  available_at timestamptz [not null]
  lease_id uuid
  lease_until timestamptz
  published_at timestamptz
  attempts integer [not null]
}

Table school_barrier {
  school_id uuid [pk, not null]
  revision_floor bigint [not null]
  pending_operation_id uuid
}

Table school_transition {
  id uuid [pk, not null]
  school_id uuid [not null]
  before_revision bigint [not null]
  after_revision bigint [not null]
  fingerprint text [not null]
  payload_json text [not null]
  status text [not null]
  created_at timestamptz [not null]
}

Table vehicle_block {
  id uuid [pk, not null]
  school_id uuid [not null]
  vehicle_id uuid [not null]
  operation_id uuid [not null]
  reason text [not null]
  status text [not null]
  created_at timestamptz [not null]
}

Table vehicle_guard {
  vehicle_id uuid [pk, not null]
  school_id uuid [not null]
}
